{
  "name": "reforma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests playwright.config.ts vite.config.ts",
    "format:check": "prettier --check src tests playwright.config.ts vite.config.ts",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "test:api": "node --import tsx --test tests/api-chat.test.ts",
    "dev:full": "npx vercel dev",
    "demo:tool": "tsx scripts/demo-tool.ts",
    "check:server-esm": "node scripts/check-server-esm.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@langchain/core": "^1.5.1",
    "@langchain/openai": "^1.8.5",
    "@tailwindcss/vite": "^4.3.5",
    "@untitledui/icons": "^0.0.23",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "langchain": "^1.6.8",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-number-format": "^5.4.5",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
